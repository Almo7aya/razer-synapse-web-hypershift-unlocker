{
  "manifest_version": 3,
  "name": "Razer Synapse Web Hypershift Unlocker",
  "short_name": "Synapse Web Unlocker",
  "version": "0.1.0",
  "description": "Discover your Synapse Web products automatically and control Hypershift mapping restrictions with a toggle for each product.",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/Almo7aya/razer-synapse-web-hypershift-unlocker",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://synapse.razer.com/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": {
    "default_title": "Synapse Web Hypershift Unlocker",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
